{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "serwis-ai-chat",
  "main": "src/index.js",
  "compatibility_date": "2026-08-13",
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "CHAT_ROOM", "class_name": "ChatRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }],
  "d1_databases": [{ "binding": "serwis_chat", "database_name": "serwis-chat", "database_id": "8b09ee3a-58ea-4b7e-a3e6-ab824146cb9d", "remote": true }],
  "assets": { "directory": "./public" }
}